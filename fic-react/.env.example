# EmailJS + reCAPTCHA (required for live form submission)
#
# Vite embeds VITE_* variables at BUILD time. Set real values in .env.local (or CI secrets)
# before running `npm run build`, then deploy the resulting `dist/` folder.
# Do not commit secrets. This file contains placeholders only.
#
# Variable names below match src/utils/email.js (there is no VITE_EMAILJS_TEMPLATE_ID).
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id

# Contact form — main notification to FI Consultancy (static: template_isbsonk)
VITE_EMAILJS_TEMPLATE_ID_CONTACT=your_contact_template_id

# Contact form — optional auto-reply to the user (static: template_auto_reply)
VITE_EMAILJS_TEMPLATE_ID_CONTACT_REPLY=your_contact_auto_reply_template_id

# Appointment form (static: template_vnsddkc)
VITE_EMAILJS_TEMPLATE_ID_APPOINTMENT=your_appointment_template_id

# Google reCAPTCHA v2 checkbox (client-side verification only; static site key was in HTML/JS)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
